// AYK PTE LTD - Solar Project Management System (Multi-tenant SaaS)
// Prisma schema — PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenant (Company) ──────────────────────────────────────────
model Tenant {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  address     String?
  uen         String?
  plan        String   @default("demo") // demo | enterprise
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  projects    Project[]
  tasks       Task[]
  workers     Worker[]
  materials   Material[]
  expenses    Expense[]
  safetyChecklists SafetyChecklist[]
  safetyIncidents SafetyIncident[]
  documents   Document[]
  notifications Notification[]
  dailyProgress  DailyProgress[]
  materialTransactions MaterialTransaction[]
  accessCodes  AccessCode[]

  @@map("tenants")
}

// ─── AccessCode ─────────────────────────────────────────────────
model AccessCode {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String?
  plan        String   @default("enterprise")
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@map("access_codes")
}

// ─── User ───────────────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  role           String   @default("Worker")
  avatar         String?
  phone          String?
  isActive       Boolean  @default(true)
  isTenantAdmin  Boolean  @default(false)
  isMasterAdmin  Boolean  @default(false)
  setupComplete  Boolean  @default(true)
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedProjects Project[] @relation("ProjectManager")
  tasks           Task[]
  dailyProgress   DailyProgress[] @relation("ProgressSubmitter")
  safetyChecklists SafetyChecklist[]
  safetyIncidents SafetyIncident[] @relation("IncidentReporter")
  documents       Document[] @relation("DocUploader")

  @@map("users")
}

// ─── Project ────────────────────────────────────────────────────
model Project {
  id              String   @id @default(cuid())
  code            String
  name            String
  location        String
  client          String?
  totalPanels     Int      @default(0)
  installedPanels Int      @default(0)
  capacity        String?
  status          String   @default("Active")
  startDate       DateTime
  endDate         DateTime
  budget          Float    @default(0)
  actualCost      Float    @default(0)
  managerId       String?
  manager         User?    @relation("ProjectManager", fields: [managerId], references: [id])
  description     String?
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stages          ProjectStage[]
  dailyProgress   DailyProgress[]
  tasks           Task[]
  expenses        Expense[]
  documents       Document[]
  notifications   Notification[]
  workers         Worker[]
  materialTransactions MaterialTransaction[]
  safetyChecklists SafetyChecklist[]
  safetyIncidents SafetyIncident[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("projects")
}

model ProjectStage {
  id          String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  order       Int      @default(0)
  plannedPct  Float    @default(0)
  actualPct   Float    @default(0)
  weight      Float    @default(16.66)
  status      String   @default("NotStarted")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_stages")
}

model DailyProgress {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date            DateTime
  installedPanels Int      @default(0)
  totalInstalled  Int      @default(0)
  manHours        Float    @default(0)
  workers         Int      @default(0)
  materialsUsed   String?
  equipmentUsed   String?
  workCompleted   String?
  workPending     String?
  siteStatus      String   @default("Normal")
  remarks         String?
  photoUrls       String?
  gpsLocation     String?
  submittedById   String?
  submittedBy     User?    @relation("ProgressSubmitter", fields: [submittedById], references: [id])
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@map("daily_progress")
}

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String?
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToName  String?
  team            String?
  priority        String   @default("Medium")
  status          String   @default("Todo")
  progress        Float    @default(0)
  startDate       DateTime
  dueDate         DateTime
  completedAt     DateTime?
  remarks         String?
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tasks")
}

model Worker {
  id          String   @id @default(cuid())
  name        String
  employeeId  String
  role        String
  team        String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phone       String?
  status      String   @default("Active")
  skillLevel  String   @default("Intermediate")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendance  Attendance[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workers")
}

model Attendance {
  id          String   @id @default(cuid())
  workerId    String
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  workingHours Float   @default(0)
  overtime    Float    @default(0)
  status      String   @default("Present")
  createdAt   DateTime @default(now())

  @@map("attendance")
}

model Material {
  id          String   @id @default(cuid())
  name        String
  category    String
  unit        String   @default("pcs")
  stockQty    Float    @default(0)
  minStockLevel Float  @default(0)
  unitPrice   Float    @default(0)
  supplier    String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions MaterialTransaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("materials")
}

model MaterialTransaction {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type        String
  qty         Float
  fromProject String?
  toProject   String?
  remarks     String?
  date        DateTime
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("material_transactions")
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category    String
  description String
  amount      Float
  paidBy      String?
  approvalStatus String @default("Pending")
  receiptUrl  String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model SafetyChecklist {
  id          String   @id @default(cuid())
  date        DateTime
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checklistType String @default("PPE")
  helmet      Boolean  @default(false)
  safetyShoes Boolean  @default(false)
  gloves      Boolean  @default(false)
  harness     Boolean  @default(false)
  workAreaClean Boolean @default(false)
  equipmentCondition Boolean @default(false)
  electricalSafety Boolean @default(false)
  conductedById String?
  conductedBy  User?   @relation(fields: [conductedById], references: [id], onDelete: SetNull)
  conductedByName String?
  location    String?
  remarks     String?
  compliancePct Float @default(0)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("safety_checklists")
}

model SafetyIncident {
  id          String   @id @default(cuid())
  date        DateTime
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type        String
  severity    String   @default("Low")
  description String
  location    String?
  reportedById String?
  reportedBy   User?   @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedByName String?
  status      String   @default("Open")
  actionTaken String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("safety_incidents")
}

model Document {
  id          String   @id @default(cuid())
  name        String
  category    String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileUrl     String
  fileType    String
  fileSize    Int      @default(0)
  uploadedById String?
  uploadedBy   User?   @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByName String?
  description String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("documents")
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isRead      Boolean  @default(false)
  severity    String   @default("info")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("notifications")
}
